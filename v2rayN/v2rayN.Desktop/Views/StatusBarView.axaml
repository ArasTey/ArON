<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid Background="Transparent">
        <Border
            x:Name="borderGlass"
            HorizontalAlignment="Center"
            Padding="14,7"
            Classes="GlassBar">
            <DockPanel>
                <StackPanel
                    x:Name="spSpeeds"
                    Margin="10,0,4,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    IsVisible="{Binding ShowTransferRates}"
                    Spacing="1">
                    <TextBlock
                        x:Name="txtSpeedProxyDisplay"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{DynamicResource GlassTextPrimaryBrush}" />
                    <TextBlock
                        x:Name="txtSpeedDirectDisplay"
                        HorizontalAlignment="Right"
                        FontSize="10.5"
                        Foreground="{DynamicResource GlassTextSecondaryBrush}" />
                </StackPanel>
                <Border
                    x:Name="borderSpeeds"
                    Width="1"
                    Height="22"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GlassHairlineBrush}"
                    DockPanel.Dock="Right"
                    IsVisible="{Binding ShowTransferRates}" />

                <StackPanel
                    x:Name="spInbound"
                    Margin="4,0,10,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Spacing="1">
                    <TextBlock
                        x:Name="txtInboundDisplay"
                        FontSize="10.5"
                        Foreground="{DynamicResource GlassTextSecondaryBrush}" />
                    <TextBlock
                        x:Name="txtInboundLanDisplay"
                        FontSize="10.5"
                        Foreground="{DynamicResource GlassTextSecondaryBrush}" />
                </StackPanel>
                <Border
                    x:Name="borderInbound"
                    Width="1"
                    Height="22"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource GlassHairlineBrush}"
                    DockPanel.Dock="Left" />

                <StackPanel
                    x:Name="spEnableTun"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <Button
                        x:Name="btnConnect"
                        Classes="ConnectButton"
                        Classes.connected="{Binding IsConnected}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Data="{StaticResource ArONPowerGeometry}"
                                Stretch="Uniform" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding ConnectButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Margin="4,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        x:Name="cmbSystemProxy"
                        Width="182"
                        Height="30"
                        Background="{DynamicResource GlassInsetBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                    </ComboBox>

                    <ComboBox
                        x:Name="cmbRoutings2"
                        Width="150"
                        Height="30"
                        Background="{DynamicResource GlassInsetBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        DisplayMemberBinding="{Binding Remarks}"
                        ItemsSource="{Binding RoutingItems}"
                        ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />
                </StackPanel>

                <StackPanel
                    Margin="10,0,4,0"
                    VerticalAlignment="Center"
                    Spacing="1"
                    ToolTip.Tip="{Binding RunningServerToolTipText}">
                    <TextBlock
                        x:Name="txtRunningServerDisplay"
                        MaxWidth="260"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource GlassTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="txtRunningInfoDisplay"
                        MaxWidth="260"
                        FontSize="10.5"
                        Foreground="{DynamicResource GlassTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
